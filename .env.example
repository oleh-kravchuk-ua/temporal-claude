# Copy to .env (local base) or .env.local (machine/secret overrides). Both are git-ignored.
# The app runs with NO env files thanks to built-in defaults (values below are the defaults).
# Precedence: real process env > .env.local > .env > defaults.

# --- Environment: development | test | production (production = JSON logs, no pretty) ---
NODE_ENV=development

# --- Logging: debug | info | warn | error ---
LOG_LEVEL=info

# --- HTTP API (Fastify) ---
HTTP_PORT=3000
HTTP_HOST=0.0.0.0
CORS_ORIGIN=*

# --- Temporal connection ---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=ai-agent
# For Temporal Cloud, set this in .env.local (never commit it):
# TEMPORAL_API_KEY=

# --- AI provider: mock | claude (mock = offline, deterministic, no key needed) ---
AI_PROVIDER=mock
# Used only when AI_PROVIDER=claude. Set the key in .env.local (never commit it):
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

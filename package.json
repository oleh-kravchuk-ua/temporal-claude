{
  "name": "temporal-claude",
  "version": "1.0.0",
  "description": "A small application to test orchestration to run AI within Temporal",
  "homepage": "https://github.com/oleh-kravchuk-ua/temporal-claude#readme",
  "bugs": {
    "url": "https://github.com/oleh-kravchuk-ua/temporal-claude/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oleh-kravchuk-ua/temporal-claude.git"
  },
  "license": "./LICENSE",
  "author": "Oleh Kravchuk <oleh.kravchuk.ua@gmail.com>",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "worker": "tsx src/worker.ts",
    "api": "tsx src/http/server.ts",
    "start": "tsx src/cli/client.ts",
    "claude:check": "tsx src/cli/claude-check.ts",
    "build": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "verify": "npm run format:check && npm run lint && npm run build && npm test",
    "test:unit": "vitest run src",
    "test:feature": "vitest run features",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@temporalio/activity": "^1.24.0",
    "@temporalio/client": "^1.24.0",
    "@temporalio/worker": "^1.24.0",
    "@temporalio/workflow": "^1.24.0",
    "fastify": "^5.12.5",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@temporalio/testing": "^1.24.0",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
